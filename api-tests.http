###
# E-Wallet Backend API Tests
# 
# This file contains HTTP requests for testing all API endpoints
# 
# HOW TO USE:
# 1. Install REST Client extension for VS Code
#    https://marketplace.visualstudio.com/items?itemName=humao.rest-client
# 
# 2. Start the application:
#    npm run start:dev
# 
# 3. Click "Send Request" above any request to execute it
# 
# 4. Variables are set from responses automatically (see @variable = {{response.body.$.field}})
#
# EXECUTION ORDER:
# 1. Register User Alice
# 2. Register User Bob
# 3. Login as Alice (to get fresh API key)
# 4. Check Alice's Balance
# 5. Get Alice's Profile
# 6. Create Transfer (should fail - insufficient balance)
# 7. Check Transaction History
# 8. Create Top-up Request
# 9. Test Webhook (simulate external service)
# 10. Check Alice's Balance Again
###

@baseUrl = http://localhost:8080
@aliceApiKey = 
@bobApiKey = 

### 1. Register User - Alice
# @name registerAlice
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "username": "alice",
  "password": "securepass123"
}

### Extract Alice's API Key
@aliceApiKey = {{registerAlice.response.body.$.apiKey}}

###

### 2. Register User - Bob
# @name registerBob
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "username": "bob",
  "password": "securepass123"
}

### Extract Bob's API Key
@bobApiKey = {{registerBob.response.body.$.apiKey}}

###

### 3. Login - Alice
# @name loginAlice
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "username": "alice",
  "password": "securepass123"
}

### Update Alice's API Key from login
@aliceApiKey = {{loginAlice.response.body.$.apiKey}}

###

### 4. Login - Bob
# @name loginBob
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "username": "bob",
  "password": "securepass123"
}

### Update Bob's API Key from login
@bobApiKey = {{loginBob.response.body.$.apiKey}}

###

### 5. Get User Profile - Alice
GET {{baseUrl}}/users/me
x-api-key: {{aliceApiKey}}

###

### 6. Get User Profile - Bob
GET {{baseUrl}}/users/me
x-api-key: {{bobApiKey}}

###

### 7. Check Balance - Alice
GET {{baseUrl}}/balance
x-api-key: {{aliceApiKey}}

###

### 8. Check Balance - Bob
GET {{baseUrl}}/balance
x-api-key: {{bobApiKey}}

###

### 9. Get Transaction History - Alice
GET {{baseUrl}}/balance/history
x-api-key: {{aliceApiKey}}

###

### 10. Get Transaction History - Bob
GET {{baseUrl}}/balance/history
x-api-key: {{bobApiKey}}

###

### 11. Create Transfer - Alice to Bob (Should FAIL - Insufficient Balance)
POST {{baseUrl}}/transfer
Content-Type: application/json
x-api-key: {{aliceApiKey}}

{
  "recipientUsername": "bob",
  "amount": 50
}

###

### 12. Create Transfer - Invalid Recipient (Should FAIL)
POST {{baseUrl}}/transfer
Content-Type: application/json
x-api-key: {{aliceApiKey}}

{
  "recipientUsername": "nonexistent",
  "amount": 10
}

###

### 13. Create Transfer - To Self (Should FAIL)
POST {{baseUrl}}/transfer
Content-Type: application/json
x-api-key: {{aliceApiKey}}

{
  "recipientUsername": "alice",
  "amount": 10
}

###

### 14. Get Transfer History - Alice
GET {{baseUrl}}/transfer/history
x-api-key: {{aliceApiKey}}

###

### 15. Create Top-up Request - Alice
# @name topupAlice
POST {{baseUrl}}/topup
Content-Type: application/json
x-api-key: {{aliceApiKey}}

{
  "amount": 100
}

###

### 16. Create Top-up Request - Bob
POST {{baseUrl}}/topup
Content-Type: application/json
x-api-key: {{bobApiKey}}

{
  "amount": 50
}

###

### 17. Get Top-up History - Alice
GET {{baseUrl}}/topup/history
x-api-key: {{aliceApiKey}}

###

### 18. Get Top-up History - Bob
GET {{baseUrl}}/topup/history
x-api-key: {{bobApiKey}}

###

### 19. Simulate Webhook - Top-up Success
# NOTE: This simulates what the external payment service would send
# In production, this would come from the external service
POST {{baseUrl}}/topup/webhook
Content-Type: application/json
x-webhook-signature: test-signature-123

{
  "webhookId": "webhook-123",
  "eventType": "topup.success",
  "topupId": "replace-with-actual-topup-id",
  "status": "SUCCESS",
  "externalTransactionId": "ext-txn-456"
}

###

### 20. Simulate Webhook - Top-up Failed
POST {{baseUrl}}/topup/webhook
Content-Type: application/json
x-webhook-signature: test-signature-456

{
  "webhookId": "webhook-456",
  "eventType": "topup.failed",
  "topupId": "replace-with-actual-topup-id",
  "status": "FAILED",
  "externalTransactionId": "ext-txn-789"
}

###

### 21. Test Authentication - No API Key (Should FAIL)
GET {{baseUrl}}/balance

###

### 22. Test Authentication - Invalid API Key (Should FAIL)
GET {{baseUrl}}/balance
x-api-key: invalid-key-12345

###

### 23. Test Validation - Invalid Username Format
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "username": "",
  "password": "password123"
}

###

### 24. Test Validation - Short Password (Should FAIL)
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "username": "testuser",
  "password": "short"
}

###

### 25. Test Validation - Negative Transfer Amount (Should FAIL)
POST {{baseUrl}}/transfer
Content-Type: application/json
x-api-key: {{aliceApiKey}}

{
  "recipientUsername": "bob",
  "amount": -50
}

###

### 26. Test Validation - Zero Transfer Amount (Should FAIL)
POST {{baseUrl}}/transfer
Content-Type: application/json
x-api-key: {{aliceApiKey}}

{
  "recipientUsername": "bob",
  "amount": 0
}

###

### 27. Test Validation - Invalid Top-up Amount (Should FAIL)
POST {{baseUrl}}/topup
Content-Type: application/json
x-api-key: {{aliceApiKey}}

{
  "amount": -100
}

###

### 28. Duplicate Registration (Should FAIL)
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "username": "alice",
  "password": "anotherpassword123"
}

###

### 29. Wrong Password Login (Should FAIL)
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "username": "alice",
  "password": "wrongpassword"
}

###

### 30. Health Check (Root endpoint)
GET {{baseUrl}}/

###

################################################################################
# SCENARIO: Complete User Journey
################################################################################

### Scenario Step 1: Register new user "charlie"
# @name registerCharlie
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "username": "charlie",
  "password": "charlie123456"
}

### Extract Charlie's API Key
@charlieApiKey = {{registerCharlie.response.body.$.apiKey}}

###

### Scenario Step 2: Check Charlie's initial balance (should be 0)
GET {{baseUrl}}/balance
x-api-key: {{charlieApiKey}}

###

### Scenario Step 3: Create top-up for Charlie
# @name topupCharlie
POST {{baseUrl}}/topup
Content-Type: application/json
x-api-key: {{charlieApiKey}}

{
  "amount": 200
}

### Extract Top-up ID
@charlieTopupId = {{topupCharlie.response.body.$.id}}

###

### Scenario Step 4: Check top-up status
GET {{baseUrl}}/topup/history
x-api-key: {{charlieApiKey}}

###

### Scenario Step 5: Simulate successful webhook for Charlie's top-up
# NOTE: Replace the topupId with actual ID from Step 3 response
POST {{baseUrl}}/topup/webhook
Content-Type: application/json
x-webhook-signature: test-signature-charlie

{
  "webhookId": "webhook-charlie-001",
  "eventType": "topup.success",
  "topupId": "{{charlieTopupId}}",
  "status": "SUCCESS",
  "externalTransactionId": "ext-txn-charlie-001"
}

###

### Scenario Step 6: Check Charlie's balance after top-up (should be 200)
GET {{baseUrl}}/balance
x-api-key: {{charlieApiKey}}

###

### Scenario Step 7: Transfer from Charlie to Bob
POST {{baseUrl}}/transfer
Content-Type: application/json
x-api-key: {{charlieApiKey}}

{
  "recipientUsername": "bob",
  "amount": 75
}

###

### Scenario Step 8: Check Charlie's balance after transfer (should be 125)
GET {{baseUrl}}/balance
x-api-key: {{charlieApiKey}}

###

### Scenario Step 9: Check Bob's balance after receiving transfer
GET {{baseUrl}}/balance
x-api-key: {{bobApiKey}}

###

### Scenario Step 10: Check Charlie's transaction history
GET {{baseUrl}}/balance/history
x-api-key: {{charlieApiKey}}

###

### Scenario Step 11: Check Charlie's transfer history
GET {{baseUrl}}/transfer/history
x-api-key: {{charlieApiKey}}

###

### Scenario Step 12: Check Bob's transfer history (should show received transfer)
GET {{baseUrl}}/transfer/history
x-api-key: {{bobApiKey}}

###

################################################################################
# END OF API TESTS
################################################################################
